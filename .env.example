# GroupCart environment variables
# Copy this file to .env and fill in your own values before running docker compose up

# MongoDB credentials
MONGO_USER=admin
MONGO_PASSWORD=changeme_strong_password

# GroupCart admin password (used to register the "admin" account)
ADMIN_PASSWORD=changeme_admin_password

# JWT signing secret — REQUIRED — generate with: openssl rand -hex 32
JWT_SECRET=replace_with_64_hex_chars_from_openssl_rand_hex_32
